{
  "name": "shrimp",
  "description": "All-in-one email service, fully hosted on Cloudflare Workers.",
  "workspaces": ["packages/*", "apps/*"],
  "packageManager": "bun@1.0.26",
  "scripts": {
    "dev": "turbo dev --filter=@shrimp/client --filter=@shrimp/server",
    "build": "turbo build",
    "lint": "turbo lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.2.2",
    "husky": "^9.1.5",
    "lint-staged": "^15.2.9",
    "turbo": "^1.13.4"
  }
}
