{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n          d.id,\n          d.domain,\n          d.created_at,\n          d.updated_at,\n          (\n            u.id,\n            u.username,\n            u.password_hash,\n            u.created_at,\n            u.updated_at\n          ) AS \"owner!: User\"\n        FROM domains d\n        INNER JOIN users u ON u.id = d.owner_id\n        WHERE d.id = $1;\n      ",
